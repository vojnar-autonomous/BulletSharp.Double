obj
bin
packages
*.suo
*.user

# Skip patches and diffs in root, if needed in future, change this
/*.patch
/*.diff

# Visual Studio
.vs/
*.VC.db
*.VC.VC.opendb

# CMake build output (e.g. libbulletc/build)
build/
CMakeCache.txt
